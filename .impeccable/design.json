  "components": [
    {
      "name": "Send button",
      "kind": "button",
      "refersTo": "button-send",
      "description": "Current native send silhouette: 32dp disc centered in a 48dp target. The native action becomes stop while streaming; this preview shows send.",
      "html": "<button class=\"ds-send\" type=\"button\" aria-label=\"发送\"><span class=\"ds-send-disc\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 7-7 7 7M12 19V5\"/></svg></span></button>",
      "css": ".ds-send{display:inline-flex;width:48px;height:48px;align-items:center;justify-content:center;padding:0;border:0;background:transparent;color:#FFFFFF}.ds-send-disc{display:flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:16px;background:#333330}.ds-send:hover .ds-send-disc,.ds-send:active .ds-send-disc{background:#333330}.ds-send:focus-visible{outline:2px solid #666662;outline-offset:2px}"
    },
    {
      "name": "Disabled send button",
      "kind": "button",
      "refersTo": "button-send-disabled",
      "description": "Unavailable send action uses a disabled fill and secondary icon, retaining the 48dp frame.",
      "html": "<button class=\"ds-send-disabled\" type=\"button\" aria-label=\"发送\" disabled><span class=\"ds-send-disabled-disc\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 7-7 7 7M12 19V5\"/></svg></span></button>",
      "css": ".ds-send-disabled{display:inline-flex;width:48px;height:48px;align-items:center;justify-content:center;padding:0;border:0;background:transparent;color:#666662}.ds-send-disabled-disc{display:flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:16px;background:#DEDEDA}.ds-send-disabled:hover .ds-send-disabled-disc,.ds-send-disabled:active .ds-send-disabled-disc{background:#DEDEDA}"
    },
    {
      "name": "Compact two-layer composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "Compact native composer: draft/model share the left inset; selected search uses quiet gray and a dot. Width below 360dp or font scale above 1.2 puts model on its own toolbar row. This is a visual translation, not a request control.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-draft\" rows=\"1\" placeholder=\"给 AI 助手发消息\" aria-label=\"问 AI\"></textarea><div class=\"ds-toolbar\"><button class=\"ds-model\" type=\"button\" aria-label=\"选择模型，GPT-6.1-sol\"><span class=\"ds-model-name\">GPT-6.1-sol</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button><button class=\"ds-search\" type=\"button\" aria-label=\"联网搜索\" aria-pressed=\"true\"><span class=\"ds-search-symbol\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20\"/></svg></span><span class=\"ds-search-dot\"></span></button><button class=\"ds-effort\" type=\"button\" aria-label=\"思考强度，低\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 18V5M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5M17.997 5.125a4 4 0 0 1 2.526 5.77M18 18a4 4 0 0 0 2-7.464M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517M6 18a4 4 0 0 1-2-7.464M6.003 5.125a4 4 0 0 0-2.526 5.77\"/></svg><span>低</span></button><button class=\"ds-composer-send\" type=\"button\" aria-label=\"发送\"><span class=\"ds-composer-disc\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 7-7 7 7M12 19V5\"/></svg></span></button></div></div>",
      "css": ".ds-composer{max-width:736px;border:1px solid #E2E2DE;border-radius:18px;padding:4px;background:#FFFFFF;color:#242423;font-family:system-ui,sans-serif}.ds-draft{display:block;width:calc(100% - 20px);min-height:24px;max-height:120px;resize:vertical;margin:0;padding:6px 10px;border:0;border-radius:0;background:transparent;color:#242423;font:400 16px/24px system-ui,sans-serif}.ds-draft::placeholder{color:#767670}.ds-toolbar{display:flex;align-items:center;gap:4px}.ds-model,.ds-search,.ds-effort,.ds-composer-send{display:flex;align-items:center;justify-content:center;gap:4px;min-width:48px;min-height:48px;padding:0 7px;border:0;border-radius:12px;background:transparent;color:#666662;font:400 12px/18px system-ui,sans-serif}.ds-model{flex:1;justify-content:flex-start;padding:0 10px;min-width:48px}.ds-model-name{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-model svg{flex-shrink:0}.ds-search{position:relative;color:#666662}.ds-search-symbol{display:flex;width:28px;height:28px;align-items:center;justify-content:center}.ds-search-dot{position:absolute;right:10px;top:9px;width:4px;height:4px;border-radius:2px;background:#666662}.ds-composer-send{width:48px;height:48px;padding:0;flex-shrink:0;color:#FFFFFF}.ds-composer-disc{display:flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:16px;background:#333330}.ds-model:hover,.ds-search:hover,.ds-effort:hover,.ds-model:active,.ds-search:active,.ds-effort:active{background:transparent}.ds-draft:focus-visible{outline:2px solid #666662;outline-offset:2px}.ds-toolbar button:focus-visible{outline:2px solid #666662;outline-offset:2px}.ds-composer{container-type:inline-size}@container (max-width:335px){.ds-toolbar{flex-wrap:wrap}.ds-model{flex-basis:100%}.ds-composer-send{margin-left:auto}}"
    },
    {
      "name": "Chat navigation",
      "kind": "nav",
      "refersTo": "chat-navigation",
      "description": "Compact native title/context stack between back and new/menu actions. Safe-area padding belongs to the native screen wrapper.",
      "html": "<nav class=\"ds-nav\" aria-label=\"AI 对话\"><button class=\"ds-nav-icon\" aria-label=\"返回\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"/></svg></button><button class=\"ds-nav-context\" aria-label=\"查看上下文\"><span class=\"ds-nav-title\">AI 助手</span><span class=\"ds-nav-meta\">来源页面：自选 · 预计输入 5.6k 词元 <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></button><button class=\"ds-nav-new\" aria-label=\"新对话\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M16 3l5 5M10 14l-1 5 5-1L22 6a2 2 0 0 0-5-5Z\"/></svg></button><button class=\"ds-nav-icon\" aria-label=\"AI 菜单\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;min-height:56px;padding:0 6px;background:#FAFAF9;color:#242423;font-family:system-ui,sans-serif}.ds-nav button{border:0;background:transparent;color:inherit;padding:0}.ds-nav-icon{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:48px;height:48px}.ds-nav-new{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:48px;height:48px}.ds-nav-context{display:flex;flex:1;min-width:0;min-height:56px;flex-direction:column;align-items:flex-start;justify-content:center;padding:0 4px!important}.ds-nav-title{font:500 16px/24px system-ui,sans-serif}.ds-nav-meta{display:flex;align-items:center;gap:4px;margin-top:1px;color:#666662;font:400 12px/18px system-ui,sans-serif}.ds-nav-icon:hover,.ds-nav-icon:active{background:transparent}.ds-nav button:focus-visible{outline:2px solid #666662;outline-offset:2px}"
    },
    {
      "name": "Capability tag",
      "kind": "chip",
      "refersTo": "chip-capability",
      "description": "Compact noninteractive capability badges; wrap within the model text column. Unknown or unavailable capabilities use shared warning colors.",
      "html": "<div class=\"ds-tags\"><span class=\"ds-tag\">联网搜索</span><span class=\"ds-tag\">200K 上下文</span><span class=\"ds-tag ds-tag-warning\">工具能力未知</span></div>",
      "css": ".ds-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px;font-family:system-ui,sans-serif}.ds-tag{padding:3px 6px;border-radius:4px;background:#F4F4F2;color:#242423;font-size:10px}.ds-tag-warning{color:#8A4B00;background:#FFF3E0}"
    },
    {
      "name": "User question bubble",
      "kind": "card",
      "refersTo": "user-bubble",
      "description": "Natural-width right-aligned question, at most 90% of the reading width; context metadata stays below.",
      "html": "<div class=\"ds-user-wrap\"><div class=\"ds-user-bubble\">结合我的持仓，先看哪些风险？</div><span class=\"ds-user-attachment\">已附带上下文：页面 持仓 · 最近操作记录 2 条</span></div>",
      "css": ".ds-user-wrap{display:flex;align-items:flex-end;flex-direction:column;margin-top:0;margin-bottom:20px;font-family:system-ui,sans-serif}.ds-user-bubble{max-width:90%;padding:10px 12px;border-radius:12px;background:#EFEFEE;color:#242423;font:400 16px/25px system-ui,sans-serif}.ds-user-attachment{margin-top:6px;color:#767670;font:400 11px/17px system-ui,sans-serif}"
    },
    {
      "name": "Local process disclosure",
      "kind": "custom",
      "refersTo": "disclosure",
      "description": "A local 48dp process summary with a nearby arrow. Expanded native details use one white bordered panel; input is a bordered code inset and output follows. Text below is explicitly a display sample; native data comes only from existing call/result parts.",
      "html": "<details class=\"ds-process\"><summary class=\"ds-process-summary\"><span>已调用 1 个工具</span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></summary><div class=\"ds-process-details\"><span>工具调用（展示样例）</span><span>调用已结束</span><pre class=\"ds-process-input\">{}</pre><code class=\"ds-process-output\">本地样例输出</code></div></details>",
      "css": ".ds-process{color:#666662;font-family:system-ui,sans-serif;font:400 13px/20px system-ui,sans-serif}.ds-process-summary{display:flex;min-height:48px;align-items:center;gap:4px;width:fit-content;max-width:100%;list-style:none;cursor:pointer}.ds-process-summary::-webkit-details-marker{display:none}.ds-process-summary span{min-width:0}.ds-process-summary svg{flex-shrink:0}.ds-process[open] .ds-process-summary svg{transform:rotate(90deg)}.ds-process-details{display:flex;flex-direction:column;gap:8px;padding:12px;margin-bottom:8px;border:1px solid #E2E2DE;border-radius:12px;background:#FFFFFF}.ds-process-input{margin:0;padding:8px;border:1px solid #E2E2DE;border-radius:8px;overflow-x:auto;color:#242423;font:400 13px/20px monospace}.ds-process-output{color:#666662;font:400 13px/20px monospace;white-space:pre-wrap}.ds-process-summary:hover,.ds-process-summary:active{background:transparent}.ds-process-summary:focus-visible{outline:2px solid #666662;outline-offset:2px}"
    },
    {
      "name": "Markdown table",
      "kind": "custom",
      "refersTo": "markdown-table",
      "description": "Fine table rules, shared column widths, soft header and local horizontal overflow. Native widths also respond to content and font scale.",
      "html": "<div class=\"ds-table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"表格，可横向滚动\"><div class=\"ds-table\"><div class=\"ds-tr ds-th\"><span class=\"ds-cell\">项目</span><span class=\"ds-cell\">观察</span><span class=\"ds-cell\">依据</span></div><div class=\"ds-tr\"><span class=\"ds-cell\">仓位</span><span class=\"ds-cell\">先持有观察</span><span class=\"ds-cell\">结合风险承受能力</span></div></div></div>",
      "css": ".ds-table-scroll{max-width:100%;overflow-x:auto;margin:6px 0 20px;border-radius:12px}.ds-table{display:table;width:max-content;border:1px solid #E2E2DE;border-radius:12px;overflow:hidden;color:#242423;font:400 14px/22px system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-tr{display:flex;border-bottom:1px solid #E2E2DE}.ds-tr:last-child{border-bottom:0}.ds-th{background:#F4F4F2;font-weight:600}.ds-cell{width:144px;padding:11px 12px}.ds-table-scroll:focus-visible{outline:2px solid #666662;outline-offset:2px}"
    },
    {
      "name": "Model choice",
      "kind": "custom",
      "refersTo": "model-choice",
      "description": "Model row with identity mark, readable name/ID, wrapping tags, and selected check. Preview controls change the checked state without invoking a provider.",
      "html": "<div class=\"ds-model-options\" role=\"radiogroup\" aria-label=\"选择模型\"><label class=\"ds-model-option\"><input class=\"ds-model-radio\" type=\"radio\" name=\"ds-model-choice\" checked/><span class=\"ds-provider-mark\">O</span><span class=\"ds-model-copy\"><span class=\"ds-model-title\">GPT-6.1-sol</span><span class=\"ds-model-sub\">OpenAI · gpt-6.1-sol</span><span class=\"ds-model-tags\"><span>思考开关</span><span>联网搜索</span><span>200K 上下文</span></span></span><span class=\"ds-model-check\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></span></label></div>",
      "css": ".ds-model-options{background:#FAFAF9;color:#242423;font-family:system-ui,sans-serif}.ds-model-option{position:relative;display:flex;align-items:flex-start;gap:10px;padding:16px;border-top:1px solid #E2E2DE;background:#F4F4F2;cursor:pointer}.ds-model-radio{position:absolute;left:16px;top:16px;width:30px;height:30px;margin:0;opacity:0}.ds-provider-mark{display:flex;width:30px;height:30px;flex-shrink:0;align-items:center;justify-content:center;border-radius:8px;background:#087F5B;color:#FFFFFF;font-size:15px;font-weight:700}.ds-model-copy{flex:1;min-width:0}.ds-model-title{display:block;font-size:15px;font-weight:500}.ds-model-sub{display:block;font-size:12px;line-height:18px;color:#666662;overflow-wrap:anywhere}.ds-model-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px}.ds-model-tags span{padding:3px 6px;border-radius:4px;background:#F4F4F2;font-size:10px}.ds-model-check{display:flex;align-items:center}.ds-model-option:hover,.ds-model-option:active{background:#F4F4F2}.ds-model-option:has(.ds-model-radio:focus-visible){outline:2px solid #666662;outline-offset:2px}"
    },
    {
      "name": "Operation confirmation card",
      "kind": "card",
      "refersTo": "operation-card",
      "description": "Bordered paper card for a pending operation; keeps explicit confirmation and inherited app action semantics. This is a visual preview and executes no trade.",
      "html": "<section class=\"ds-operation\"><h3 class=\"ds-operation-title\">待确认操作</h3><div class=\"ds-operation-row\"><span>操作</span><span>模拟买入</span></div><div class=\"ds-operation-row\"><span>数量</span><span>100 股</span></div><div class=\"ds-operation-buttons\"><button class=\"ds-operation-cancel\" type=\"button\">取消</button><button class=\"ds-operation-run\" type=\"button\">确认执行</button></div></section>",
      "css": ".ds-operation{margin:10px 0;padding:16px;border:1px solid #E2E2DE;border-radius:14px;background:#FFFFFF;color:#242423;font-family:system-ui,sans-serif}.ds-operation-title{margin:0 0 10px;font-size:16px;line-height:24px;font-weight:600}.ds-operation-row{display:flex;justify-content:space-between;gap:16px;padding:5px 0;font-size:14px;line-height:22px}.ds-operation-row span:first-child{color:#666662}.ds-operation-row span:last-child{flex-shrink:1;text-align:right;font-variant-numeric:tabular-nums}.ds-operation-buttons{display:flex;gap:12px;margin-top:12px}.ds-operation-buttons button{min-height:48px;flex:1;padding:12px 16px;border-radius:6px;font:500 15px system-ui,sans-serif}.ds-operation-cancel{border:1px solid #ECEDEF;background:#FFFFFF;color:#1F2329}.ds-operation-run{border:0;background:#E5322D;color:#FFFFFF}.ds-operation-buttons button:hover,.ds-operation-buttons button:active{opacity:.8}.ds-operation-buttons button:focus-visible{outline:2px solid #666662;outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "参考图的连续对话与局部过程（Android 适配）",
    "overview": "The user-selected references establish a continuous conversation on a near-white field: native Chinese text, quiet local process summaries, a pale right-aligned question, and a single bottom composer. Tool stages stay beside the explanation that follows them; the assistant reads as continuous analysis rather than a sequence of white message cards. This is a code-led adaptation of `docs/design/references/agent-conversation.png` and `agent-expanded.png`, with no generated imagery or shipping raster assets.\n\nThis system applies to the Android AI conversation, its Markdown renderer, and in-chat model/thinking selectors. It does not replace the stock application's visual world. Trading screens retain the cool gray background, white cards, compact controls, tabular numerals, red rises/green falls, and existing semantic colors in `src/ui/theme.ts` and `src/ui/components/ui.tsx`. Shared operation buttons inside the conversation retain those established action semantics.\n\nThe current system is recorded from `codex/release-agent-ui-preview`, based on v0.9.0. It is light-only. The system-dark capture verifies that the existing light app remains legible; it does not establish a dark palette. Eight native Android phone captures cover normal type, 1.3× type, a narrower phone, keyboard, empty state, model sheet, table, and expanded details. `.impeccable/review/agent-finish-review.md` records disposition **ship**. Physical hardware, a full TalkBack traversal, iOS, tablet, and live supplier calls remain unverified. Earlier `composer-review.md` and chat-detail records describe past versions; they are not the current preview verdict.",
    "keyCharacteristics": [
      "Continuous assistant text with paragraph and heading rhythm.",
      "Near-white neutral surfaces; dark primary action; semantic color reserved for actual state.",
      "Native font scaling, touch controls, and safe-area/keyboard accommodation.",
      "Compact two-layer composer with left-aligned draft and model name.",
      "Local collapsed process stages with visible errors and explicit operation confirmation.",
      "Local AI styling that preserves the surrounding trading interface."
    ],
    "rules": [
      {
        "name": "The Local Palette Rule",
        "body": "Use this near-neutral palette only on the AI reading surface and its chat selectors. Preserve the existing stock application's red/green market semantics and shared action colors.",
        "section": "colors"
      },
      {
        "name": "The Reading Hierarchy Rule",
        "body": "Keep the native body role and its line height as the default for assistant prose. Use the three observed heading roles for content structure and semibold for local emphasis.",
        "section": "typography"
      },
      {
        "name": "The Composer Alignment Rule",
        "body": "Keep the draft and model label on the same left inset. Keep search and thinking visually light, with the send disc at the right and full touch targets around the compact symbols.",
        "section": "typography"
      },
      {
        "name": "The Flat Reading Rule",
        "body": "Keep assistant prose on the page. Use soft tone for code and the question, and a thin bordered white panel for expanded process details. Keep a concrete operation in its own confirmation card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep assistant answers continuous on the near-white page and preserve the native body/heading hierarchy.",
      "**Do** contain horizontal overflow inside tables and code, and let capability tags wrap.",
      "**Do** preserve 48dp chat targets, native font scaling, safe-area padding, keyboard avoidance, stop, and return-to-latest behavior.",
      "**Do** keep draft and model text left-aligned on the same inset, with compact icon controls and a 32dp send disc inside its 48dp target.",
      "**Do** keep process disclosures at their actual message position while showing errors and pending confirmations directly.",
      "**Do** retain shared trading status colors and existing stock-screen components outside the AI scope."
    ],
    "donts": [
      "**Don't** restore a white rounded card or repeated model banner around every assistant answer, or gather all process stages ahead of the answer.",
      "**Don't** move the desktop reference's sidebar into the phone or claim an independently designed dark theme.",
      "**Don't** shrink prose or touch targets to make a narrow or enlarged-font layout fit.",
      "**Don't** center the model, add a large filled search tile, or restore the rejected taller composer.",
      "**Don't** let a disclosure, streaming update, or model selector steal the reader's chosen scroll position.",
      "**Don't** invent provider capabilities, execute a pending operation without confirmation, or replace interface icons with decorative imagery."
    ]
  }
}
